+  void Presenter::antiLagUpdate(VkDevice device, VkAntiLagStageAMD stage) {
+	  static uint32_t lastFrame = 0;
+	  if (m_antiLag && lastFrame != m_frameIndex) {
+	    VkAntiLagPresentationInfoAMD  presentationInfo = {
+		    VK_STRUCTURE_TYPE_ANTI_LAG_PRESENTATION_INFO_AMD, // sType
+		    nullptr,                                          // pNext
+		    stage,                      // stage
+		    m_frameIndex,                                // frameIndex
+	    };
+	  
+	    const VkAntiLagDataAMD data = {
+		    VK_STRUCTURE_TYPE_ANTI_LAG_DATA_AMD, // sType
+		    nullptr,							                // pNext
+		    VK_ANTI_LAG_MODE_ON_AMD,			        // mode
+		    m_fpsLimiter.m_maxFPS,	              // maxFPS
+		    &presentationInfo,			              // pPresentationInfo
+	    };
+      Logger::debug(str::format("AntiLag update stage ", stage, " frame ", m_frameIndex));
+	    m_vkd->vkAntiLagUpdateAMD(device, &data);
+      
+    }
+  }
+
+  void Presenter::antiLagIPC() {
+	  HANDLE hPipe;
+    char out=2, in;
+    DWORD bytes;
+
+    // Create a named pipe
+    hPipe = CreateNamedPipeA(
+        "\\\\.\\pipe\\AntiLag",// pipe name
+        PIPE_ACCESS_DUPLEX,    // write access only
+        PIPE_TYPE_BYTE | PIPE_WAIT, // byte-type pipe, blocking mode
+        1,                     // max instances
+        1024,                  // output buffer size
+        1024,                  // input buffer size
+        0,                     // default timeout (ms)
+        NULL                   // security attributes
+    );
+
+    if (hPipe == INVALID_HANDLE_VALUE) {
+        Logger::warn(str::format("Failed to create named pipe. Error: ", GetLastError()));
+        return;
+    }
+
+    Logger::info("Waiting for client to connect...\n");
+    // Wait for client connection
+    bool connected = ConnectNamedPipe(hPipe, NULL) ? true : (GetLastError() == ERROR_PIPE_CONNECTED);
+
+    if (connected) {
+      Logger::info("Antilag client connected");
+    } else {
+      Logger::warn(str::format("Failed to connect to client. Error: ", GetLastError()));
+    }
+    
+    while(true){
+      if (ReadFile(hPipe, &in, 1, &bytes, NULL)) {
+        if (in == 1) {
+          Logger::debug("AntiLag call requested");
+          //std::this_thread::sleep_for(std::chrono::seconds(1));
+          antiLagUpdate(m_vkd->device(), VK_ANTI_LAG_STAGE_INPUT_AMD);
+          WriteFile(hPipe, &out, 1, &bytes, NULL);
+        }
+      } else {
+        Logger::debug("pipe read error");
+        CloseHandle(hPipe);
+        return;
+      }
+
+      if (!m_antiLag) {
+        Logger::info("Closing antilag IPC");
+        CloseHandle(hPipe);
+        return;
+      }
+	  }
+
+	  // Close the pipe
+    CloseHandle(hPipe);
+  }
 
